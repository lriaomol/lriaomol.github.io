---
// src/pages/index.astro
// Home page — Alejandro Riaño-Molina
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Alejandro Riaño-Molina — Mechanical & Aerospace Engineer</title>
  <meta name="description" content="Ph.D. student at University of Michigan. Computational mechanics, solid mechanics, and aerospace systems." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & Base ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #080810;
      --bg2:       #0e0e1a;
      --bg3:       #13131f;
      --border:    rgba(120,120,200,0.12);
      --border2:   rgba(120,120,200,0.22);
      --primary:   #7B8CFF;
      --cyan:      #22D3EE;
      --text:      #E8E8F0;
      --muted:     #6B6B8A;
      --muted2:    #9090B0;
      --font-head: 'Syne', sans-serif;
      --font-body: 'DM Sans', sans-serif;
      --font-mono: 'DM Mono', monospace;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.7;
      overflow-x: hidden;
    }

    ::selection { background: rgba(123,140,255,0.3); }

    /* ── Noise overlay ────────────────────────────────────────── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* ── Grid Lines ───────────────────────────────────────────── */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(123,140,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(123,140,255,0.025) 1px, transparent 1px);
      background-size: 80px 80px;
      pointer-events: none;
      z-index: 0;
    }

    /* ── Nav ──────────────────────────────────────────────────── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 1.25rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s, background 0.3s;
      backdrop-filter: blur(0px);
    }

    nav.scrolled {
      border-color: var(--border);
      background: rgba(8,8,16,0.85);
      backdrop-filter: blur(16px);
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--muted2);
      letter-spacing: 0.05em;
      text-decoration: none;
    }

    .nav-logo span { color: var(--primary); }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--text); }

    /* ── Hero ─────────────────────────────────────────────────── */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 0 2.5rem;
      z-index: 1;
    }

    .hero-inner {
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
      padding-top: 6rem;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--cyan);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 1.75rem;
      opacity: 0;
      animation: fadeUp 0.6s ease forwards 0.1s;
    }

    .hero-tag::before {
      content: '';
      display: block;
      width: 24px;
      height: 1px;
      background: var(--cyan);
    }

    h1 {
      font-family: var(--font-head);
      font-size: clamp(2.8rem, 7vw, 5.5rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.2s;
    }

    h1 .accent { color: var(--primary); }

    h1 .line-2 {
      display: block;
      color: var(--muted2);
      font-weight: 500;
    }

    .hero-sub {
      max-width: 560px;
      font-size: 1.05rem;
      color: var(--muted2);
      line-height: 1.75;
      margin-bottom: 2.5rem;
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.35s;
    }

    .hero-ctas {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.5s;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--primary);
      color: #080810;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.85rem 1.75rem;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }

    .btn-primary:hover { background: #9AAEFF; transform: translateY(-1px); }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      color: var(--muted2);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.85rem 1.75rem;
      border: 1px solid var(--border2);
      text-decoration: none;
      transition: color 0.2s, border-color 0.2s, transform 0.15s;
    }

    .btn-ghost:hover {
      color: var(--text);
      border-color: rgba(120,120,200,0.45);
      transform: translateY(-1px);
    }

    /* Hero stats */
    .hero-stats {
      display: flex;
      gap: 3rem;
      margin-top: 4rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--border);
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.65s;
    }

    .stat-item { }

    .stat-num {
      font-family: var(--font-head);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text);
      display: block;
      line-height: 1;
      margin-bottom: 0.35rem;
    }

    .stat-num span { color: var(--primary); }

    .stat-label {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* Hero canvas background */
    #hero-canvas {
      position: absolute;
      top: 0; right: 0;
      width: 55%;
      height: 100%;
      opacity: 0.18;
      pointer-events: none;
    }

    /* ── Section shared ───────────────────────────────────────── */
    section {
      position: relative;
      z-index: 1;
      padding: 6rem 2.5rem;
    }

    .section-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-tag {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--primary);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .section-tag::before {
      content: '';
      display: block;
      width: 20px;
      height: 1px;
      background: var(--primary);
    }

    h2 {
      font-family: var(--font-head);
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    /* ── About ────────────────────────────────────────────────── */
    #about {
      border-top: 1px solid var(--border);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: start;
      margin-top: 3rem;
    }

    .about-text p {
      color: var(--muted2);
      margin-bottom: 1.2rem;
      font-size: 1rem;
    }

    .about-text p strong {
      color: var(--text);
      font-weight: 500;
    }

    .about-text .highlight {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .about-right { }

    /* Timeline */
    .timeline {
      list-style: none;
      position: relative;
      padding-left: 1.5rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 1px;
      background: var(--border2);
    }

    .timeline li {
      position: relative;
      padding-left: 1.5rem;
      margin-bottom: 2rem;
    }

    .timeline li::before {
      content: '';
      position: absolute;
      left: -1.5rem;
      top: 6px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--bg);
      border: 1.5px solid var(--primary);
    }

    .timeline li.current::before {
      background: var(--primary);
      box-shadow: 0 0 8px rgba(123,140,255,0.6);
    }

    .tl-date {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.08em;
      margin-bottom: 0.2rem;
    }

    .tl-title {
      font-family: var(--font-head);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.15rem;
    }

    .tl-place {
      font-size: 0.85rem;
      color: var(--muted2);
    }

---
// src/components/Experience.astro
// Paste this component into your index.astro or create as a separate component
---
 
<!-- ── Experience Section ─────────────────────────────────────── -->
<section id="experience">
  <div class="section-inner">
    <div class="section-tag">Experience</div>
    <h2>Research &amp; institutions</h2>
 
    <div class="exp-list">
 
      <!-- University of Michigan -->
      <div class="exp-item reveal">
        <div class="exp-header">
          <div class="exp-logo-wrap">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/9/93/University_of_Michigan_logo.svg/240px-University_of_Michigan_logo.svg.png"
              alt="University of Michigan"
              class="exp-logo"
              loading="lazy"
            />
          </div>
          <div class="exp-meta">
            <div class="exp-institution">University of Michigan</div>
            <div class="exp-location">Ann Arbor, MI, USA</div>
            <div class="exp-period">2024 → Present</div>
          </div>
          <div class="exp-badge current">Current</div>
        </div>
 
        <div class="exp-roles">
          <div class="exp-role">
            <div class="role-title">Ph.D. Student — Mechanical Engineering</div>
            <div class="role-desc">
              Doctoral research in solid mechanics, computational mechanics, 
              and data-driven computing. Expected graduation: May 2030.
            </div>
            <div class="role-tags">
              <span class="tag">Solid Mechanics</span>
              <span class="tag">Computational Mech.</span>
              <span class="tag">C++</span>
              <span class="tag">Data-Driven Computing</span>
            </div>
          </div>
        </div>
      </div>
 
      <!-- Purdue University -->
      <div class="exp-item reveal">
        <div class="exp-header">
          <div class="exp-logo-wrap">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/27/Purdue_Boilermakers_logo.svg/240px-Purdue_Boilermakers_logo.svg.png"
              alt="Purdue University"
              class="exp-logo"
              loading="lazy"
            />
          </div>
          <div class="exp-meta">
            <div class="exp-institution">Purdue University</div>
            <div class="exp-location">West Lafayette, IN, USA</div>
            <div class="exp-period">Aug 2023 – Feb 2024</div>
          </div>
        </div>
 
        <div class="exp-roles">
          <div class="exp-role">
            <div class="role-title">Undergraduate Research Assistant</div>
            <div class="role-desc">
              Finite element simulations analyzing localized high-temperature-rate 
              regions in energetic materials under shock wave conditions.
              Advised by Dr. Marisol Koslowski.
            </div>
            <div class="role-tags">
              <span class="tag">FEA</span>
              <span class="tag">Shock Mechanics</span>
              <span class="tag">Energetic Materials</span>
              <span class="tag">Thermal Analysis</span>
            </div>
          </div>
        </div>
      </div>
 
      <!-- Universidad Nacional de Colombia -->
      <div class="exp-item reveal">
        <div class="exp-header">
          <div class="exp-logo-wrap">
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/1b/Escudo_de_la_Universidad_Nacional_de_Colombia.svg/240px-Escudo_de_la_Universidad_Nacional_de_Colombia.svg.png"
              alt="Universidad Nacional de Colombia"
              class="exp-logo"
              loading="lazy"
            />
          </div>
          <div class="exp-meta">
            <div class="exp-institution">Universidad Nacional de Colombia</div>
            <div class="exp-location">Bogotá, Colombia</div>
            <div class="exp-period">2019 – 2024</div>
          </div>
        </div>
 
        <div class="exp-roles">
 
          <div class="exp-role">
            <div class="role-title">B.S. Mechanical Engineering — GPA 4.3/5</div>
            <div class="role-desc">
              Graduated September 2024. Thesis: <em>"Application of finite elements 
              for the analysis of the response of materials exposed to extreme conditions."</em>
              Award for outstanding results in international academic tests (2022).
            </div>
            <div class="role-tags">
              <span class="tag">Thesis</span>
              <span class="tag">FEA</span>
              <span class="tag">Extreme Conditions</span>
            </div>
          </div>
 
          <div class="exp-role">
            <div class="role-title">Aerospace Research Assistant — GIDA Group</div>
            <div class="role-desc">
              Analyzed Hydrogen Embrittlement in engine valves using Phase Field 
              Damage Model (PFDM), HEDE, and HELP. CFD characterization of HHX 
              FullJet injector with OpenFOAM. Presented at IAC Milan 2024, CEC 2023, 
              and CATE 2021. Analog mission design as ground control officer.
            </div>
            <div class="role-tags">
              <span class="tag">MOOSE</span>
              <span class="tag">OpenFOAM</span>
              <span class="tag">Phase Field</span>
              <span class="tag">CFD</span>
              <span class="tag">Aerospace</span>
            </div>
          </div>
 
          <div class="exp-role">
            <div class="role-title">Structural Engineer — NASA HERC Rover</div>
            <div class="role-desc">
              Led structural design and FEA optimization of rover transmission 
              and frame. Used additive and traditional manufacturing. 
              Won NASA Safety Award 2022 (Artemis program). 
              Presented at IAC Milan 2024.
            </div>
            <div class="role-tags">
              <span class="tag">FEA</span>
              <span class="tag">Topology Optimization</span>
              <span class="tag">Additive Mfg.</span>
              <span class="tag">NASA HERC</span>
            </div>
          </div>
 
        </div>
      </div>
 
    </div>
  </div>
</section>
 
<style>
  /* ── Experience section ───────────────────────────────────── */
  #experience {
    position: relative;
    z-index: 1;
    padding: 6rem 2.5rem;
    border-top: 1px solid var(--border);
  }
 
  .exp-list {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5px;
    background: var(--border);
  }
 
  .exp-item {
    background: var(--bg);
    padding: 2.5rem;
    transition: background 0.25s;
  }
 
  .exp-item:hover { background: var(--bg2); }
 
  /* Header row: logo + meta + badge */
  .exp-header {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
 
  .exp-logo-wrap {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border2);
    border-radius: 12px;
    padding: 10px;
    flex-shrink: 0;
  }
 
  .exp-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    transition: opacity 0.2s;
  }
 
  .exp-item:hover .exp-logo { opacity: 1; }
 
  .exp-meta { flex: 1; }
 
  .exp-institution {
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }
 
  .exp-location {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.3rem;
  }
 
  .exp-period {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted2);
  }
 
  .exp-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 2px;
    flex-shrink: 0;
  }
 
  .exp-badge.current {
    color: var(--cyan);
    border: 1px solid rgba(34,211,238,0.3);
    background: rgba(34,211,238,0.06);
  }
 
  /* Roles inside each institution */
  .exp-roles {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
 
  .exp-role {
    padding-left: 1.25rem;
    border-left: 2px solid var(--border2);
    transition: border-color 0.2s;
  }
 
  .exp-item:hover .exp-role { border-color: rgba(123,140,255,0.3); }
 
  .role-title {
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.4rem;
  }
 
  .role-desc {
    font-size: 0.875rem;
    color: var(--muted2);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
 
  .role-desc em {
    color: var(--muted2);
    font-style: italic;
  }
 
  .role-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
 
  /* Responsive */
  @media (max-width: 600px) {
    #experience { padding: 4rem 1.5rem; }
    .exp-header { flex-wrap: wrap; gap: 1rem; }
    .exp-badge { margin-left: 0; }
  }
</style>


    /* ── Featured projects ────────────────────────────────────── */
    #projects {
      border-top: 1px solid var(--border);
    }

    .projects-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 3rem;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5px;
      background: var(--border);
    }

    .project-card {
      background: var(--bg);
      padding: 2.25rem;
      position: relative;
      overflow: hidden;
      text-decoration: none;
      color: var(--text);
      display: block;
      transition: background 0.25s;
    }

    .project-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(123,140,255,0.06), transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .project-card:hover { background: var(--bg2); }
    .project-card:hover::before { opacity: 1; }

    .project-card:hover .project-arrow { transform: translate(3px, -3px); }

    .project-num {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.1em;
      margin-bottom: 1.25rem;
    }

    .project-title {
      font-family: var(--font-head);
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: 0.75rem;
    }

    .project-desc {
      font-size: 0.875rem;
      color: var(--muted2);
      line-height: 1.65;
      margin-bottom: 1.5rem;
    }

    .project-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--muted2);
      border: 1px solid var(--border2);
      padding: 0.25rem 0.6rem;
    }

    .project-arrow {
      position: absolute;
      top: 2rem;
      right: 2rem;
      font-size: 1.1rem;
      color: var(--muted);
      transition: transform 0.25s, color 0.25s;
    }

    .project-card:hover .project-arrow { color: var(--primary); }

    /* Award badge */
    .project-award {
      font-family: var(--font-mono);
      font-size: 10px;
      color: #F59E0B;
      border: 1px solid rgba(245,158,11,0.3);
      background: rgba(245,158,11,0.06);
      padding: 0.2rem 0.55rem;
      display: inline-block;
      margin-bottom: 1rem;
    }

    /* ── Skills ───────────────────────────────────────────────── */
    #skills {
      border-top: 1px solid var(--border);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--border);
      margin-top: 3rem;
    }

    .skill-group {
      background: var(--bg);
      padding: 2rem;
    }

    .skill-group-title {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--cyan);
