---
// src/pages/index.astro — Alejandro Riaño-Molina (EN)
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Alejandro Riaño-Molina — Mechanical & Aerospace Engineer"
  description="Ph.D. student at University of Michigan. Computational mechanics, solid mechanics, phase field damage, finite element analysis, hydrogen embrittlement, aerospace systems."
  lang="en"
>

  <!-- Nav -->
  <nav id="navbar">
    <a href="/" class="nav-logo">ARM<span>.</span></a>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#awards">Awards</a></li>
      <li><a href="#contact">Contact</a></li>
      <li><a href="/es/" class="lang-toggle"><span class="current">EN</span> / ES</a></li>
    </ul>
  </nav>

  <!-- Hero -->
  <section id="hero">
    <canvas id="hero-canvas"></canvas>
    <!--
      OPTIONAL HERO VIDEO:
      To add a background video of one of your simulations behind the hero text,
      uncomment the line below and place your file at /public/videos/hero.mp4
      (ideally a 10–20s muted loop of a FEA / phase field / shock-wave simulation,
      ~5–10 MB, no audio, dark background so it blends with the page).
    -->
    <video id="hero-video" src="/videos/hero.mp4" autoplay muted loop playsinline></video>

    <div class="hero-inner">
      <div class="hero-tag">Ph.D. Student · University of Michigan</div>
      <h1>
        Engineering at<br>
        the <span class="accent">limits</span> of
        <span class="line-2">materials &amp; mechanics.</span>
      </h1>
      <p class="hero-sub">
        I build computational models where structures meet their physical boundaries —
        from phase field damage in aerospace components to finite element simulations
        of materials under extreme conditions.
      </p>
      <div class="hero-ctas">
        <a href="#projects" class="btn-primary"><span>See my work</span><span>↓</span></a>
        <a href="mailto:alejorm@umich.edu" class="btn-ghost"><span>Get in touch</span></a>
      </div>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-num">3</span>
          <span class="stat-label">Conference papers</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">3</span>
          <span class="stat-label">Research institutions</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">3</span>
          <span class="stat-label">Working languages</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">HERC</span>
          <span class="stat-label">NASA Safety Award · 2022</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="section-inner">
      <div class="section-tag">About</div>
      <div class="about-grid">
        <div class="about-text reveal">
          <p class="highlight">
            I'm a mechanical engineer from Colombia, now a Ph.D. student at the University of Michigan —
            driven by a precise question: <strong>how do materials fail, and how do we predict it before they do?</strong>
          </p>
          <p>
            My work lives at the intersection of <strong>solid mechanics, computational modeling,
            and aerospace engineering</strong>. I've analyzed hydrogen embrittlement in engine valves,
            simulated shock wave effects in energetic materials at Purdue, and contributed to the structural
            design of a rover for NASA's Human Exploration Rover Challenge.
          </p>
          <p>
            Beyond the lab, I'm an active member of the <strong>Space Generation Advisory Council</strong>,
            where I've led workshops across South America to connect the next generation of space engineers.
          </p>
          <p>Based in Ann Arbor, MI. Originally from Villapinzón, Cundinamarca — Colombia. I work in English, Spanish, and French.</p>
          <br />
          <a href="mailto:alejorm@umich.edu" class="btn-ghost" style="display:inline-flex;">Open to collaborations →</a>
        </div>
        <div class="about-right reveal">
          <ul class="timeline">
            <li class="current">
              <div class="tl-date">2024 → Present</div>
              <div class="tl-title">Ph.D. in Mechanical Engineering</div>
              <div class="tl-place">University of Michigan, Ann Arbor</div>
            </li>
            <li>
              <div class="tl-date">2023 – 2024</div>
              <div class="tl-title">Undergraduate Research Assistant</div>
              <div class="tl-place">Purdue University · Dr. Marisol Koslowski</div>
            </li>
            <li>
              <div class="tl-date">2021 – 2023</div>
              <div class="tl-title">Structural Design Lead · NASA HERC Rover</div>
              <div class="tl-place">Universidad Nacional de Colombia</div>
            </li>
            <li>
              <div class="tl-date">2019 – 2024</div>
              <div class="tl-title">Aerospace Research Group</div>
              <div class="tl-place">GIDA · Universidad Nacional de Colombia</div>
            </li>
            <li>
              <div class="tl-date">2018 – 2024</div>
              <div class="tl-title">B.S. Mechanical Engineering · GPA 4.3/5</div>
              <div class="tl-place">Universidad Nacional de Colombia</div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience">
    <div class="section-inner">
      <div class="section-tag">Experience</div>
      <h2>Research &amp; institutions</h2>
      <div class="exp-list">

        <!-- University of Michigan -->
        <div class="exp-item reveal">
          <div class="exp-header">
            <div class="exp-logo-wrap">
              <img src="/images/U-M_Logo-Hex.png" alt="University of Michigan" class="exp-logo" loading="lazy" />
            </div>
            <div class="exp-meta">
              <div class="exp-institution">University of Michigan</div>
              <div class="exp-location">Ann Arbor, MI, USA</div>
              <div class="exp-period">2024 → Present</div>
            </div>
            <div class="exp-badge current">Current</div>
          </div>
          <div class="exp-roles">
            <div class="exp-role">
              <div class="role-title">Ph.D. Student — Mechanical Engineering</div>
              <div class="role-desc">Doctoral research in solid mechanics, computational mechanics, and data-driven computing. Expected graduation: May 2030.</div>
              <div class="role-tags">
                <span class="tag">Solid Mechanics</span>
                <span class="tag">Computational Mech.</span>
                <span class="tag">C++</span>
                <span class="tag">Data-Driven Computing</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Purdue University -->
        <div class="exp-item reveal">
          <div class="exp-header">
            <div class="exp-logo-wrap">
              <!-- TODO: download Purdue logo to /public/images/purdue-logo.png -->
              <img src="/images/purdue-logo.png" alt="Purdue University" class="exp-logo" loading="lazy" onerror="this.style.display='none'" />
            </div>
            <div class="exp-meta">
              <div class="exp-institution">Purdue University</div>
              <div class="exp-location">West Lafayette, IN, USA</div>
              <div class="exp-period">Aug 2023 – Feb 2024</div>
            </div>
          </div>
          <div class="exp-roles">
            <div class="exp-role">
              <div class="role-title">Undergraduate Research Assistant</div>
              <div class="role-desc">Finite element simulations analyzing localized high-temperature-rate regions in energetic materials under shock wave conditions. Advised by Dr. Marisol Koslowski.</div>
              <div class="role-tags">
                <span class="tag">FEA</span>
                <span class="tag">Shock Mechanics</span>
                <span class="tag">Energetic Materials</span>
                <span class="tag">Thermal Analysis</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Universidad Nacional de Colombia -->
        <div class="exp-item reveal">
          <div class="exp-header">
            <div class="exp-logo-wrap">
              <!-- TODO: download UNAL logo to /public/images/unal-logo.png -->
              <img src="/images/unal-logo.png" alt="Universidad Nacional de Colombia" class="exp-logo" loading="lazy" onerror="this.style.display='none'" />
            </div>
            <div class="exp-meta">
              <div class="exp-institution">Universidad Nacional de Colombia</div>
              <div class="exp-location">Bogotá, Colombia</div>
              <div class="exp-period">2019 – 2024</div>
            </div>
          </div>
          <div class="exp-roles">
            <div class="exp-role">
              <div class="role-title">B.S. Mechanical Engineering — GPA 4.3/5</div>
              <div class="role-desc">Graduated September 2024. Thesis: <em>"Application of finite elements for the analysis of the response of materials exposed to extreme conditions."</em> Award for outstanding results in international academic tests (2022).</div>
              <div class="role-tags">
                <span class="tag">Thesis</span>
                <span class="tag">FEA</span>
                <span class="tag">Extreme Conditions</span>
              </div>
            </div>
            <div class="exp-role">
              <div class="role-title">Aerospace Research Assistant — GIDA Group</div>
              <div class="role-desc">Analyzed Hydrogen Embrittlement in engine valves using Phase Field Damage Model (PFDM), HEDE, and HELP. CFD characterization of HHX FullJet injector with OpenFOAM. Presented at IAC Milan 2024, CEC 2023, and CATE 2021.</div>
              <div class="role-tags">
                <span class="tag">MOOSE</span>
                <span class="tag">OpenFOAM</span>
                <span class="tag">Phase Field</span>
                <span class="tag">CFD</span>
                <span class="tag">Aerospace</span>
              </div>
            </div>
            <div class="exp-role">
              <div class="role-title">Structural Design Lead — NASA HERC Rover</div>
              <div class="role-desc">Led the structural design and FEA team for the rover transmission and frame. Combined topology optimization with additive and traditional manufacturing. Received the Safety Award at NASA's Human Exploration Rover Challenge 2022.</div>
              <div class="role-tags">
                <span class="tag">FEA</span>
                <span class="tag">Topology Optimization</span>
                <span class="tag">Additive Mfg.</span>
                <span class="tag">NASA HERC</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="section-inner">
      <div class="projects-header">
        <div>
          <div class="section-tag">Featured work</div>
          <h2>Selected projects</h2>
        </div>
      </div>
      <div class="projects-grid reveal">

        <a href="/projects/hydrogen-embrittlement" class="project-card">
          <span class="project-arrow">↗</span>
          <!--
            THUMBNAIL: place an image at /public/images/projects/hydrogen-thumb.jpg
            (recommended 1280×800, FEA visualization / phase field render).
            If the file is missing, the placeholder grid pattern is shown.
          -->
          <div class="project-thumb placeholder" data-label="FEA · Phase Field">
            <img src="/images/projects/hydrogen-thumb.jpg" alt="Hydrogen embrittlement simulation" loading="lazy" onerror="this.style.display='none'" />
          </div>
          <div class="project-body">
            <div class="project-num">01</div>
            <h3 class="project-title">Hydrogen Embrittlement in Aerospace Engine Valves</h3>
            <p class="project-desc">Phase Field Damage Model (PFDM) combined with HEDE and HELP mechanisms to analyze hydrogen-induced failure in structural engine components.</p>
            <div class="project-tags">
              <span class="tag">FEA</span><span class="tag">MOOSE</span><span class="tag">Phase Field</span><span class="tag">C++</span>
            </div>
          </div>
        </a>

        <a href="/projects/energetic-materials" class="project-card">
          <span class="project-arrow">↗</span>
          <div class="project-thumb placeholder" data-label="Shock Waves · Thermal FEA">
            <img src="/images/projects/energetic-thumb.jpg" alt="Shock wave simulation in energetic materials" loading="lazy" onerror="this.style.display='none'" />
          </div>
          <div class="project-body">
            <div class="project-num">02</div>
            <div class="project-award">Purdue University</div>
            <h3 class="project-title">FE Simulation of Shock Waves in Energetic Materials</h3>
            <p class="project-desc">Finite element analysis of localized high-temperature-rate regions in energetic materials under shock wave loading conditions.</p>
            <div class="project-tags">
              <span class="tag">ANSYS</span><span class="tag">Shock Mechanics</span><span class="tag">Thermal FEA</span>
            </div>
          </div>
        </a>

        <a href="/projects/nasa-herc-rover" class="project-card">
          <span class="project-arrow">↗</span>
          <!--
            VIDEO OPTION: to use a video instead of an image, swap <img> for:
            <video src="/videos/rover-loop.mp4" autoplay muted loop playsinline></video>
          -->
          <div class="project-thumb placeholder" data-label="NASA HERC · Rover">
            <img src="/images/projects/rover-thumb.jpg" alt="NASA HERC Rover" loading="lazy" onerror="this.style.display='none'" />
          </div>
          <div class="project-body">
            <div class="project-num">03</div>
            <div class="project-award">⭑ NASA Safety Award 2022</div>
            <h3 class="project-title">Structural Design &amp; FEA — NASA HERC Rover</h3>
            <p class="project-desc">Led structural design and FEA optimization of rover transmission and frame components. Competed in NASA's Human Exploration Rover Challenge.</p>
            <div class="project-tags">
              <span class="tag">FEA</span><span class="tag">Topology Opt.</span><span class="tag">Additive Mfg.</span><span class="tag">Autodesk</span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills">
    <div class="section-inner">
      <div class="section-tag">Technical stack</div>
      <h2>Skills &amp; tools</h2>
      <div class="skills-grid reveal">
        <div class="skill-group">
          <div class="skill-group-title">Simulation</div>
          <ul class="skill-list">
            <li>MOOSE Framework</li><li>ANSYS Mechanical</li><li>ANSYS Fluent</li><li>OpenFOAM</li><li>ParaView</li>
          </ul>
        </div>
        <div class="skill-group">
          <div class="skill-group-title">Programming</div>
          <ul class="skill-list">
            <li>C++</li><li>Python</li><li>MATLAB / Simulink</li><li>LaTeX</li><li>Linux / Bash</li>
          </ul>
        </div>
        <div class="skill-group">
          <div class="skill-group-title">CAD &amp; Design</div>
          <ul class="skill-list">
            <li>Autodesk Inventor</li><li>AutoCAD</li><li>OpenRocket</li><li>Additive Mfg.</li><li>Adobe Photoshop</li>
          </ul>
        </div>
        <div class="skill-group">
          <div class="skill-group-title">Research</div>
          <ul class="skill-list">
            <li>Solid Mechanics</li><li>Computational Mech.</li><li>Phase Field Models</li><li>Data-Driven Computing</li><li>Math Modeling</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Awards -->
  <section id="awards">
    <div class="section-inner">
      <div class="section-tag">Recognition</div>
      <h2>Honors &amp; awards</h2>
      <div class="awards-list reveal">
        <div class="award-item">
          <span class="award-year">2024</span>
          <div><div class="award-name">Space Generation Leadership Award (SGLA)</div><div class="award-org">Space Generation Advisory Council — Vienna, Austria</div></div>
          <span class="award-icon">🏆</span>
        </div>
        <div class="award-item">
          <span class="award-year">2024</span>
          <div><div class="award-name">IAC Conference Presenter</div><div class="award-org">International Astronautical Congress — Milan, Italy</div></div>
          <span class="award-icon">🛰️</span>
        </div>
        <div class="award-item">
          <span class="award-year">2022</span>
          <div><div class="award-name">Safety Award — NASA Human Exploration Rover Challenge</div><div class="award-org">NASA HERC · Motion of congratulations from the Ministry of Education, Colombia</div></div>
          <span class="award-icon">🚀</span>
        </div>
        <div class="award-item">
          <span class="award-year">2022</span>
          <div><div class="award-name">Award for Outstanding Results in International Academic Tests</div><div class="award-org">Universidad Nacional de Colombia</div></div>
          <span class="award-icon">⭑</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <div class="section-inner">
      <div class="contact-inner reveal">
        <h2 class="contact-heading">Let's build<br><span class="dim">something precise.</span></h2>
        <p class="contact-sub">Open to research collaborations between Michigan and other groups — joint papers, computational mechanics projects, and aerospace work.</p>
        <div class="contact-links">
          <a href="mailto:alejorm@umich.edu" class="contact-link">✉ alejorm@umich.edu</a>
          <a href="https://linkedin.com/in/lriaomol" class="contact-link" target="_blank" rel="noopener">↗ LinkedIn</a>
          <a href="https://github.com/lriaomol" class="contact-link" target="_blank" rel="noopener">↗ GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <span class="footer-text">Alejandro Riaño-Molina <span>·</span> Ann Arbor, MI</span>
    <span class="footer-text">Built with Astro <span>·</span> Hosted on GitHub Pages</span>
  </footer>

  <script is:inline>
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 40);
    });

    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));

    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      function resize() { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; }
      resize();
      window.addEventListener('resize', resize);
      const NODES = 28;
      const nodes = Array.from({ length: NODES }, () => ({
        x: Math.random(), y: Math.random(),
        vx: (Math.random() - 0.5) * 0.0003,
        vy: (Math.random() - 0.5) * 0.0003,
      }));
      function draw() {
        const W = canvas.width, H = canvas.height;
        ctx.clearRect(0, 0, W, H);
        for (let i = 0; i < NODES; i++) {
          for (let j = i + 1; j < NODES; j++) {
            const dx = nodes[i].x - nodes[j].x, dy = nodes[i].y - nodes[j].y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 0.28) {
              const alpha = (1 - dist/0.28) * 0.7;
              const t = dist/0.28;
              ctx.strokeStyle = `rgba(${Math.round(34+t*89)},${Math.round(211-t*140)},${Math.round(238-t*38)},${alpha})`;
              ctx.lineWidth = (1 - dist/0.28) * 1.2;
              ctx.beginPath();
              ctx.moveTo(nodes[i].x*W, nodes[i].y*H);
              ctx.lineTo(nodes[j].x*W, nodes[j].y*H);
              ctx.stroke();
            }
          }
        }
        nodes.forEach(n => {
          ctx.beginPath();
          ctx.arc(n.x*W, n.y*H, 1.5, 0, Math.PI*2);
          ctx.fillStyle = 'rgba(123,140,255,0.6)';
          ctx.fill();
        });
        nodes.forEach(n => {
          n.x += n.vx; n.y += n.vy;
          if (n.x < 0 || n.x > 1) n.vx *= -1;
          if (n.y < 0 || n.y > 1) n.vy *= -1;
        });
        requestAnimationFrame(draw);
      }
      draw();
    }
  </script>

</Layout>
